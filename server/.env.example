# MIRRORZ licensing server — copy to .env and fill in. Never commit .env.
PORT=8787
HOST=0.0.0.0
DB_PATH=./data/mirrorz.sqlite
LOG_LEVEL=info

# Ed25519 private key (PKCS#8 PEM). Generate with: npm run keygen
LICENSE_SIGNING_KEY_PEM=

# Entitlement policy
GRACE_DAYS=7
PERPETUAL_UPDATE_DAYS=365
TOKEN_TTL_DAYS=30
DEVICE_LIMIT_STANDARD=3
DEVICE_LIMIT_PRO=5
DEVICE_LIMIT_BUSINESS=10

# Apple (App Store Server Notifications V2 + StoreKit 2 link)
APPLE_BUNDLE_ID=com.mirrorz.app
APPLE_ENVIRONMENT=any            # Sandbox | Production | any
# Either run scripts/fetch-apple-root.sh or paste the PEM here
APPLE_ROOT_CA_PEM=

# Google Play (RTDN via Pub/Sub push + Play Developer API)
GOOGLE_PACKAGE_NAME=com.mirrorz.companion
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUSH_TOKEN=               # shared secret appended as ?token= to the push endpoint

# Stripe (direct sales on the website)
STRIPE_WEBHOOK_SECRET=

# Transactional email for license keys (optional; console fallback)
RESEND_API_KEY=
MAIL_FROM=MIRRORZ <licenses@mirrorz.app>

# Admin API bearer token
ADMIN_TOKEN=
